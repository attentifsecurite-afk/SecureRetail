# SecureRetail Ops — Variables d'environnement (TEMPLATE)
# ⚠️  Ce fichier contient des valeurs FACTICES
# 📖 Copiez ce fichier vers .env et remplacez par vos vraies valeurs
# 🔐 Ensuite, chiffrez-le avec: node scripts/encrypt-env.js

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Google Maps API
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Obtenez votre clé sur: https://console.cloud.google.com/
# Activez: Maps JavaScript API
# VITE_GOOGLE_MAPS_API_KEY=votre_clé_api_google_maps

VITE_GOOGLE_MAPS_API_KEY=AIzaSyBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ShopGuard AI Engine (Backend Python)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# URL de l'API ShopGuard (backend de détection IA)
VITE_SHOPGUARD_API_URL=http://localhost:8900

# WebSocket pour les alertes temps réel
VITE_SHOPGUARD_WS_URL=ws://localhost:8900/ws

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
