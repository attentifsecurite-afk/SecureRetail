# Backend Configuration
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secureretail

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_STARTER=price_starter_plan_id
STRIPE_PRICE_PROFESSIONAL=price_professional_plan_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_plan_id

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ShopGuard AI Engine
SHOPGUARD_API_URL=http://localhost:8900
SHOPGUARD_WS_URL=ws://localhost:8900/ws

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@secureretail-ops.fr

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
